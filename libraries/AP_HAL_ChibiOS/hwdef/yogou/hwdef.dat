# hw definition file for processing by chibios_pins.py
# for Crossrace-H  hardware from RadioLink

# MCU class and specific type
MCU STM32H7xx STM32H743xx

# board ID for firmware load
APJ_BOARD_ID 3

# crystal frequency
OSCILLATOR_HZ 16000000

FLASH_SIZE_KB 2048

#I2C order
I2C_ORDER I2C1 I2C4

# USARTs (and USB) order
SERIAL_ORDER OTG1 USART1 USART2 UART4 UART5 UART7 UART8

#SPI defined

#SPI1
PB3 SPI1_SCK SPI1 RESET HIGH
PB4 SPI1_MISO SPI1 
PB5 SPI1_MOSI SPI1 RESET HIGH

#SPI2
PB10 SPI2_SCK SPI2 RESET HIGH
PC2 SPI2_MISO SPI2
PC1 SPI2_MOSI SPI2 RESET HIGH

#SPI3
PC10 SPI3_SCK SPI3 RESET HIGH
PC11 SPI3_MISO SPI3 
PC12 SPI3_MOSI SPI3 RESET HIGH

#SPI4
PE2 SPI4_SCK SPI4 RESET HIGH
PE5 SPI4_MISO SPI4
PE6 SPI4_MOSI SPI4 RESET HIGH

# setup for power brick
PC4 BATT_VOLTAGE_SENS ADC1 SCALE(1)
PC5 BATT_CURRENT_SENS ADC1 SCALE(1)
define HAL_BATT_VOLT_PIN 4
define HAL_BATT_CURR_PIN 8
define HAL_BATT_VOLT_SCALE 12.1 
define HAL_BATT_CURR_SCALE 43.0


PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1


#I2C
PD12 EXT_I2C_SDA I2C4
PD13 EXT_I2C_SCL I2C4

PB6 BARO_SCL I2C1
PB7 BARO_SDA I2C1

#TELEM
PA9  USART1_TX USART1
PA10 USART1_RX USART1

PD5 USART2_TX USART2
PD6 USART2_RX USART2

PB8 UART4_RX UART4
PB9 UART4_TX UART4

PB12 UART5_RX UART5
PB13 UART5_TX UART5

PE7 UART7_RX UART7

PE0 UART8_RX UART8
PE1 UART8_TX UART8

#CS
PC13 IMU0_CS CS HIGH
PD2 OSD_CS CS HIGH
PA3 IMU1_CS CS HIGH
PD4 FLASH_CS CS HIGH

#OUTPUT
PE9  TIM1_CH1 TIM1 PWM(1) GPIO(50)
PE11 TIM1_CH2 TIM1 PWM(2) GPIO(51)
PE13 TIM1_CH3 TIM1 PWM(3) GPIO(52)
PE14 TIM1_CH4 TIM1 PWM(4) GPIO(53)
PA1 TIM2_CH2 TIM2 PWM(5) GPIO(54)

# SPI devices
# SPIDEV bmi270_1   SPI4 DEVID1 IMU0_CS    MODE3 2*MHZ  8*MHZ
# SPIDEV bmi270_2   SPI2 DEVID2 IMU1_CS    MODE3 2*MHZ  8*MHZ
SPIDEV 42688_1   SPI4 DEVID1 IMU0_CS    MODE3 2*MHZ  8*MHZ
SPIDEV 42688_2   SPI2 DEVID2 IMU1_CS    MODE3 2*MHZ  8*MHZ
SPIDEV dataflash  SPI3 DEVID4 FLASH_CS    MODE3 32*MHZ 32*MHZ
SPIDEV osd        SPI1 DEVID4 OSD_CS   MODE0 10*MHZ 10*MHZ

# PWM output for buzzer
PA2 TIM2_CH3 TIM2 GPIO(24) ALARM

# one baro
BARO SPL06  I2C:0:0x76
BARO SPL06  I2C:1:0x76

define AP_BARO_SPL06_ENABLED 1
define HAL_BARO_ALLOW_INIT_NO_BARO 1

# dual IMU
# IMU BMI270 SPI:bmi270_1 ROTATION_NONE
# IMU BMI270 SPI:bmi270_2 ROTATION_YAW_90

IMU Invensensev3 SPI:42688_1 ROTATION_NONE
IMU Invensensev3 SPI:42688_2 ROTATION_YAW_90

# one external I2C probe
define ALLOW_ARM_NO_COMPASS
define HAL_COMPASS_DEFAULT HAL_COMPASS_NONE
define HAL_PROBE_EXTERNAL_I2C_COMPASSES
define HAL_I2C_INTERNAL_MASK 1
define HAL_COMPASS_AUTO_ROT_DEFAULT 2

# enable logging to dataflash
define HAL_LOGGING_DATAFLASH_ENABLED 1

# leave 1 sectors free
FLASH_RESERVE_START_KB 384

# use last 2 pages for flash storage
# H743 has 16 pages of 128k each
STORAGE_FLASH_PAGE 1
define HAL_STORAGE_SIZE 32768

# setup for OSD
define OSD_ENABLED 1
define HAL_OSD_TYPE_DEFAULT 1
ROMFS_WILDCARD libraries/AP_OSD/fonts/font0.bin

# Control Zero has a TriColor LED, Red, Green, Blue
define AP_NOTIFY_GPIO_LED_RGB_ENABLED 1

# LED setup for PixracerLED driver
PC6 LED_R OUTPUT HIGH GPIO(0)
PD15  LED_G OUTPUT HIGH GPIO(1)
PD14  LED_B OUTPUT HIGH GPIO(2)

define AP_NOTIFY_GPIO_LED_RGB_RED_PIN 0
define AP_NOTIFY_GPIO_LED_RGB_GREEN_PIN 1
define AP_NOTIFY_GPIO_LED_RGB_BLUE_PIN 2

# bootloader embedding / bootloader flashing not available
define AP_BOOTLOADER_FLASHING_ENABLED 1